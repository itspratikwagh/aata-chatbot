# ── Anthropic (Claude) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional. Defaults to claude-sonnet-4-6 (fast + great at tool use).
# Set to claude-opus-4-7 for the most capable model.
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional. Max tokens for each Claude response.
ANTHROPIC_MAX_TOKENS=2048

# ── Salesforce Connected App (OAuth 2.0) ───────────────────────────
SF_CLIENT_ID=your_connected_app_consumer_key
SF_CLIENT_SECRET=your_connected_app_consumer_secret
# Obtain SF_REFRESH_TOKEN + SF_INSTANCE_URL once via:  npm run sf:auth
SF_REFRESH_TOKEN=your_refresh_token
SF_INSTANCE_URL=https://your-domain.my.salesforce.com
# https://login.salesforce.com for production, https://test.salesforce.com for sandbox
SF_LOGIN_URL=https://login.salesforce.com

# ── Server ─────────────────────────────────────────────────────────
PORT=8080
# Comma-separated allowed CORS origins for the frontend. "*" allows all.
# e.g. https://your-app.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=*

# ── Optional safety caps ───────────────────────────────────────────
MAX_AGENT_ITERATIONS=6
MAX_QUERY_ROWS=200
